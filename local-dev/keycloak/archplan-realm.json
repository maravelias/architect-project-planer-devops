{
  "realm": "archplan",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "loginTheme": "archplan",
  "roles": {
    "realm": [
      { "name": "PM Role", "description": "Project Manager" },
      { "name": "system-full-access", "description": "system-full-access" }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "System",
      "lastName": "Admin",
      "email": "admin@local.com",
      "credentials": [ { "type": "password", "value": "admin", "temporary": false } ],
      "realmRoles": ["SYSADM" , "system-full-access" ]
    },
    {
      "username": "pm1",
      "enabled": true,
      "firstName": "Project",
      "lastName": "Manager",
      "email": "pm1@local.com",
      "credentials": [ { "type": "password", "value": "password", "temporary": false } ],
      "realmRoles": ["PM Role" , "system-full-access" ]
    }
  ],
  "clients": [
    {
      "clientId": "archplan-frontend",
      "name": "Architect Project Planer Frontend",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
      "webOrigins": ["+"]
    },
    {
      "clientId": "archplan-backend",
      "name": "Architect Project Planer",
      "publicClient": false,
      "protocol": "openid-connect",
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
      "secret": "changeme-in-prod",
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "foo",
            "id.token.claim": "false",
            "lightweight.claim": "false",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}
